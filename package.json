{
  "name": "obsidian-vaultsync",
  "version": "0.1.0",
  "private": true,
  "author": "upiscium",
  "license": "AGPL-3.0-or-later",
  "description": "Conservative, mobile-compatible WebDAV sync for Obsidian",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "smoke:mobile": "node scripts/smoke-mobile.mjs",
    "test:live": "node scripts/live-nextcloud.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0",
    "node-diff3": "^3.2.0",
    "picomatch": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/picomatch": "^4.0.2",
    "esbuild": "^0.25.12",
    "obsidian": "^1.8.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
